# Ignore everything in the root
/*

# Allow the .gitignore file itself
!.gitignore

# allow specific code and input directories
!code_adhi_2lev_seaice_update
!code_adlo*_2lev_seaice_update
!input_adhi
!input_adlo*
!*.sh

# Allow mappings Python source, but not caches
!mappings/
mappings/__pycache__/
!mappings/*.py

# ignore some sverdrup stuff
submit_HR_32x32.sh
submit_HR_48x48.sh
submit_LR6_spinup.sh
